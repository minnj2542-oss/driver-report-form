{
  "manifest_version": 3,
  "name": "물품 이상 신고 대시보드",
  "version": "1.1.0",
  "description": "기사님 물품 이상 신고 목록을 브라우저 옆 사이드패널에서 바로 확인하고 복사/처리완료 처리합니다.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["alarms", "sidePanel", "notifications", "storage"],
  "host_permissions": [
    "https://blue-snowflake-09f5.6611cc.workers.dev/*"
  ]
}
